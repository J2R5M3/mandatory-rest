---
import '../global.css';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>mandatory.rest</title>
</head>
<body class="bg-black text-green-400 font-pixel min-h-screen flex items-center justify-center p-4">
    <main class="max-w-2xl w-full border-4 border-green-500 p-8 shadow-[8px_8px_0_0_rgba(34,197,94,1)]">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-center uppercase tracking-widest drop-shadow-[4px_4px_0_rgba(0,100,0,1)]">
            mandatory.rest
        </h1>

        <div class="space-y-6 text-sm md:text-base leading-relaxed">
            <p class="text-green-300">
                > SYSTEM INITIALIZED.
            </p>
            <p>
                This system operates on the principle of <span class="text-white bg-green-900 px-2">consent by authentication</span>.
                It bypasses the logistical nightmare of group chats.
            </p>
            <p>
                It does not negotiate. It asks for calendar tokens, runs the math, forces the commitment, and self-destructs.
            </p>

            <div class="mt-8 border-t-2 border-green-800 pt-8 flex justify-center">
                <button id="initialize-trap" class="bg-green-500 hover:bg-green-400 text-black font-bold py-4 px-8 border-b-4 border-green-700 hover:border-green-500 hover:translate-y-[2px] transition-all uppercase tracking-wider">
                    [ Initialize Trap ]
                </button>
                <script>
                    document.getElementById('initialize-trap')?.addEventListener('click', async () => {
                        const sessionId = 'session-' + Date.now();
                        const res = await fetch('/api/sessions', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                id: sessionId,
                                title: 'Dinner Trap',
                                duration_mins: 120,
                                window_start: new Date(Date.now() + 1000 * 60 * 60 * 24).toISOString(), // Tomorrow
                                window_end: new Date(Date.now() + 1000 * 60 * 60 * 24 * 7).toISOString(), // Next week
                                timer_deadline: new Date(Date.now() + 1000 * 60 * 60 * 24 * 2).toISOString(), // Deadline in 2 days
                                interval_days: 14
                            })
                        });
                        if (res.ok) {
                            window.location.href = '/s/' + sessionId;
                        } else {
                            alert('Failed to initialize trap: ' + (await res.json()).error);
                        }
                    });
                </script>
            </div>
        </div>
    </main>
</body>
</html>
