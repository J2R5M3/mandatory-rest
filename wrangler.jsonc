/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mandatory-rest",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-16",
	"vars": {
		//public identifiers
		"GOOGLE_CLIENT_ID": "10095119539-rt6pr0oa6bg9m5p0jdk3pus881mdug4t.apps.googleusercontent.com",
		"MICROSOFT_CLIENT_ID": "azuer id"
	}
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["* * * * *"],
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mandatory_rest_db",
			"database_id": "5ba99acf-cef4-46ed-8bd3-314b85b29f23",
		},
	],
}
